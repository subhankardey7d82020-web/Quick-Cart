{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "quick-cart-backend": {
      "root": "server",
      "framework": "express",
      "buildCommand": "npm install && node prisma/setup.js && node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma && node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "quick-cart-backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "quick-cart-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
